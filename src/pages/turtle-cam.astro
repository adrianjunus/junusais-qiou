---
import Base from '../layouts/Base.astro';

// HLS URL published by the MediaMTX + Cloudflare Tunnel setup on the home
// network (see docs/turtle-cam-streaming.md). Set PUBLIC_STREAM_URL in .env
// locally and in the hosting platform's env var settings for production.
const STREAM_URL = import.meta.env.PUBLIC_STREAM_URL;
---

<Base
  title="Turtle Cam — Junusais quoi"
  description="A live view of the tank. Refreshes on its own; no need to reload."
>
  <div class="page-head">
    <h1>Turtle Cam</h1>
    <p>A live view of the tank. Refreshes on its own; no need to reload.</p>
  </div>

  <div class="turtle-screen">
    <span id="turtle-pill" class="tag live-pill tag-neutral">OFFLINE</span>
    <video
      id="turtle-video"
      class="turtle-video"
      data-stream-url={STREAM_URL}
      muted
      autoplay
      playsinline
    ></video>
    <span id="turtle-placeholder" class="placeholder-text">Connecting…</span>
  </div>

  <div class="turtle-stats">
    <span class="tag tag-outline">78°F</span>
    <span class="tag tag-outline">Last fed: today</span>
    <span class="tag tag-outline">Water: clear</span>
  </div>

  <p class="turtle-caption">
    Streamed straight from the tank. If the tank cam or home network is down, this falls back to
    a static message until the feed reconnects.
  </p>

  <script>
    import Hls from 'hls.js';

    function initTurtleStream() {
      const video = document.getElementById('turtle-video');
      const pill = document.getElementById('turtle-pill');
      const placeholder = document.getElementById('turtle-placeholder');
      const streamUrl = video.dataset.streamUrl;

      const setLive = (live) => {
        pill.textContent = live ? 'LIVE' : 'OFFLINE';
        pill.classList.toggle('tag-accent', live);
        pill.classList.toggle('tag-neutral', !live);
        placeholder.style.display = live ? 'none' : 'block';
        video.style.display = live ? 'block' : 'none';
      };

      setLive(false);

      if (!streamUrl) {
        placeholder.textContent = 'Camera feed not configured.';
        return;
      }

      if (video.canPlayType('application/vnd.apple.mpegurl')) {
        // Safari has native HLS support.
        video.src = streamUrl;
        video.addEventListener('playing', () => setLive(true));
        video.addEventListener('error', () => setLive(false));
        return;
      }

      if (!Hls.isSupported()) {
        placeholder.textContent = 'Live feed unavailable in this browser.';
        return;
      }

      const hls = new Hls({ liveSyncDurationCount: 3 });
      hls.loadSource(streamUrl);
      hls.attachMedia(video);
      hls.on(Hls.Events.ERROR, (_event, data) => {
        if (data.fatal) setLive(false);
      });
      video.addEventListener('playing', () => setLive(true));
    }

    initTurtleStream();
  </script>
</Base>
