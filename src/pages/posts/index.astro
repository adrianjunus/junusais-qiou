---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const allPosts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const writingPosts = allPosts.filter((post) => post.data.category === 'writing' && !post.data.draft);
const portfolioPosts = allPosts.filter((post) => post.data.category === 'portfolio');
const plannedTopics = allPosts
  .filter((post) => post.data.category === 'writing' && post.data.draft)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<Base title="Posts — Junusais quoi" description="Life stuff. What I'm up to, or thinking about.">
  <div class="page-head">
    <h1>Posts</h1>
    <p>Life stuff. What I'm up to, or thinking about. Or just thing's that I want to write down so I don't forget.</p>
  </div>

  <div class="tabs">
    <input type="radio" name="post-tab" id="tab-writing" class="tab-input" checked />
    <input type="radio" name="post-tab" id="tab-portfolio" class="tab-input" />

    <div class="tab-labels">
      <label for="tab-writing" class="tab-label">Writing</label>
      <label for="tab-portfolio" class="tab-label">Portfolio</label>
    </div>

    <div class="tab-panel" data-panel="writing">
      <div class="post-list">
        {writingPosts.map((post) => (
          <article class="post-list-row">
            <div class="post-meta">
              <span class="post-date">{dateFormatter.format(post.data.date)}</span>
              <span class="tag tag-accent">{post.data.tag}</span>
            </div>
            <h2 class="post-title">
              <a href={`/posts/${post.slug}`}>{post.data.title}</a>
            </h2>
            <p class="post-excerpt">{post.data.excerpt}</p>
          </article>
        ))}
        <div class="post-list-end"></div>
      </div>

      {plannedTopics.length > 0 && (
        <div class="planned-topics card">
          <p class="card-kicker">On the list</p>
          <p class="planned-topics-intro">Topics I'm planning to write about next:</p>
          <ul class="planned-topics-list">
            {plannedTopics.map((post) => (
              <li>{post.data.title}</li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="tab-panel" data-panel="portfolio">
      <div class="post-list">
        {portfolioPosts.map((post) => (
          <article class="post-list-row">
            <div class="post-meta">
              <span class="post-date">{dateFormatter.format(post.data.date)}</span>
            </div>
            <h2 class="post-title">
              <a href={post.data.link ?? `/posts/${post.slug}`}>{post.data.title}</a>
            </h2>
            <p class="post-excerpt">{post.data.excerpt}</p>
          </article>
        ))}
        <div class="post-list-end"></div>
      </div>
    </div>
  </div>
</Base>
