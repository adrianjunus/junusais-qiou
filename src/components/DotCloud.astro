---
// Decorative stippled dot-cloud: small circles scattered along a single
// smooth wave, faint accent-colored texture behind the home hero.
// Pure decoration (aria-hidden, pointer-events: none) — coordinates are
// generated at build time from a fixed seed so output is stable.

const WIDTH = 540;
const HEIGHT = 200;
const DOT_COUNT = 220;

function mulberry32(seed: number) {
  return function () {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(42);

const dots = Array.from({ length: DOT_COUNT }, (_, i) => {
  const t = i / DOT_COUNT;
  const x = t * WIDTH;
  const waveY = HEIGHT * 0.55 + Math.sin(t * Math.PI * 2.2) * HEIGHT * 0.28;
  const cx = x + (rand() - 0.5) * 46;
  const cy = waveY + (rand() - 0.5) * 76;
  const r = 1 + rand() * 1.6;
  const o = 0.02 + rand() * 0.1;
  return {
    cx: Math.round(cx * 10) / 10,
    cy: Math.round(cy * 10) / 10,
    r: Math.round(r * 10) / 10,
    o: Math.round(o * 100) / 100,
  };
});
---

<svg
  class="hero-dots"
  aria-hidden="true"
  viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
  width="640"
  height="240"
>
  {dots.map((d) => (
    <circle cx={d.cx} cy={d.cy} r={d.r} fill="var(--color-accent)" fill-opacity={d.o} />
  ))}
</svg>
